# Doubao (Volcengine Ark) — primary LLM
DOUBAO_MODEL=your-doubao-model
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=your-doubao-api-key

# Search API Keys
TAVILY_API_KEY=your-tavily-api-key
JINA_API_KEY=your-jina-api-key

# Fallback LLM providers (optional)
# QWEN_API_KEY=your-qwen-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ── Feishu integration (all optional) ──────────────────────────────────────
# Set to true to enable each feature.
# Common required: FEISHU_APP_ID + FEISHU_APP_SECRET
FEISHU_NOTIFY_ENABLED=false        # 分析完成飞书私聊通知 → additionally needs FEISHU_NOTIFY_OPEN_ID
FEISHU_DOC_AUTO_EXPORT=false       # 分析完成自动导出为飞书文档
FEISHU_DOC_MANUAL_EXPORT=false     # 报告卡片显示「导出飞书」按钮
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_NOTIFY_OPEN_ID=
FEISHU_TENANT=
